{
  "name": "@pc-control/capacitor-pc-control",
  "version": "0.1.0",
  "private": true,
  "description": "Android native bridge for the PC Control application",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@pc-control/core": "workspace:*",
    "@pc-control/pairing-protocol": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@pc-control/eslint-config": "workspace:*",
    "@pc-control/tsconfig": "workspace:*",
    "eslint": "10.9.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.5.0 <9.0.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}
