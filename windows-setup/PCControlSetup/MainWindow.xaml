<Window x:Class="PCControlSetup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PC Control Setup · Part 1" Width="880" Height="820" MinWidth="720" MinHeight="650" Closing="OnClosing">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <TextBlock Text="PC Control Setup" FontSize="28" FontWeight="Bold" />
  <TextBlock Margin="0,12" TextWrapping="Wrap" Text="Windows SSH 초기 설정 · 동일한 사설 LAN에서 사용하세요. SSH 계정과 네트워크를 직접 선택하세요. 설정 완료 후 이 프로그램은 필요하지 않습니다." />
  <Button x:Name="InspectButton" Content="1. 환경 진단 / 새로 고침" Click="Inspect" Margin="0,5" />
  <TextBlock Text="SSH로 사용할 Windows 로컬 계정 (UAC 관리자와 다를 수 있습니다)" />
  <ComboBox x:Name="Account" Margin="0,5" />
  <TextBlock Text="휴대폰에서 접근할 사설 IPv4 (Private 네트워크 프로필 필요)" />
  <ComboBox x:Name="Network" DisplayMemberPath="Label" Margin="0,5" />
  <TextBlock TextWrapping="Wrap" Margin="0,8" Text="SSH 키는 계정의 셸 권한을 제공합니다. 관리자 계정의 공유 키 파일은 다른 관리자 계정에도 적용됩니다. 일반 계정을 권장하며 종료 권한은 별도 검증하세요. 기존 SSH 인증 정책과 포트는 변경하지 않습니다." />
  <Button x:Name="PrepareButton" Content="2. OpenSSH 설치·서비스·LAN 방화벽 구성" Click="Prepare" Margin="0,5" />
  <WrapPanel>
   <Button x:Name="PairButton" Content="3. 새 HTTPS 페어링 QR" Click="StartPairing" Margin="0,5,10,5" />
   <Button Content="페어링 중단 / 임시 리소스 정리" Click="StopPairing" Margin="0,5" />
  </WrapPanel>
  <Image x:Name="Qr" Width="290" Height="290" />
  <TextBlock Text="QR 대신 아래 JSON 전체를 앱에 붙여 넣을 수 있습니다. 세션 정보는 다른 사람과 공유하지 마세요." TextWrapping="Wrap" />
  <TextBox x:Name="BootstrapText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" />
  <TextBlock x:Name="Pending" TextWrapping="Wrap" FontWeight="Bold" Margin="0,12" />
  <WrapPanel><Button x:Name="ApproveButton" Content="코드·기기 확인 후 공개키 등록 승인" Click="Approve" Margin="0,0,10,5" IsEnabled="False" /><Button x:Name="RejectButton" Content="거절" Click="Reject" IsEnabled="False" /></WrapPanel>
  <Expander Header="수동 등록 / 복구" Margin="0,10"><StackPanel>
   <TextBlock Text="앱에서 복사한 SSH 공개키 한 줄. 개인키를 입력하지 마세요." />
   <TextBox x:Name="ManualKey" MaxLength="8192" />
   <Button Content="공개키 검증 후 수동 등록" Click="ManualRegister" Margin="0,5" />
   <Button Content="미완료 공개키 등록 복구 + 이전 임시 방화벽 정리" Click="Recover" />
  </StackPanel></Expander>
  <TextBox x:Name="Status" IsReadOnly="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="240" VerticalScrollBarVisibility="Auto" />
 </StackPanel></ScrollViewer>
</Window>
